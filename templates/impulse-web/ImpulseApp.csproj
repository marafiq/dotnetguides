<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <RootNamespace>ImpulseApp</RootNamespace>
  </PropertyGroup>

  <!-- Impulse Framework -->
  <ItemGroup>
    <PackageReference Include="Impulse.Core" Version="1.0.0" />
    <PackageReference Include="Impulse.SourceGen" Version="1.0.0" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Import MSBuild targets for TypeScript extraction -->
  <Import Project="$(NuGetPackageRoot)impulse.sourcegen\1.0.0\build\Impulse.SourceGen.targets"
          Condition="Exists('$(NuGetPackageRoot)impulse.sourcegen\1.0.0\build\Impulse.SourceGen.targets')" />

  <!-- TypeScript/Vite Build Integration -->
  <Target Name="NpmInstall" BeforeTargets="BuildTypeScript" Condition="!Exists('node_modules')">
    <Exec Command="npm install --silent" />
  </Target>

  <Target Name="BuildTypeScript" BeforeTargets="Build" DependsOnTargets="ExtractImpulseTypeScript" Condition="Exists('package.json')">
    <!-- TypeScript type checking -->
    <Exec Command="npx tsc --noEmit" />
    <!-- Production build with Vite (hashed assets) -->
    <Exec Command="npm run build" Condition="'$(Configuration)' == 'Release'" />
  </Target>

</Project>
