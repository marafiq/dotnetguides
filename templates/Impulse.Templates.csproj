<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageVersion>1.0.0</PackageVersion>
    <PackageId>Impulse.Templates</PackageId>
    <Title>Impulse Web Application Templates</Title>
    <Authors>Impulse Framework</Authors>
    <Description>Templates for creating Impulse web applications with .NET and React</Description>
    <PackageTags>dotnet-new;templates;web;react;typescript;impulse</PackageTags>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="impulse-web\**\*" Exclude="impulse-web\**\bin\**;impulse-web\**\obj\**;impulse-web\**\node_modules\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>
