<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <RootNamespace>Moj.Sandbox</RootNamespace>

    <!-- TypeScript generation settings -->
    <TsOutputDirectory>Generated\ts</TsOutputDirectory>
    <EnableTsGeneration>true</EnableTsGeneration>
  </PropertyGroup>

  <!-- DSL Library references -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Moj.TanStack.Dsl\Moj.TanStack.Dsl.csproj" />
    <ProjectReference Include="..\..\src\Moj.TanStack.Ast\Moj.TanStack.Ast.csproj" />
  </ItemGroup>

  <!-- Source Generator reference -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Moj.TanStack.SourceGenerator\Moj.TanStack.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- MSBuild task reference -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Moj.TanStack.MsBuild\Moj.TanStack.MsBuild.csproj" />
  </ItemGroup>

</Project>
