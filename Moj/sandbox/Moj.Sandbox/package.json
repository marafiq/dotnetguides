{
  "name": "moj-sandbox",
  "version": "1.0.0",
  "description": "Sandbox for testing TanStack DSL code generation",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate": "tsc --noEmit Generated/ts/*.ts",
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/store": "^0.7.0",
    "@tanstack/react-store": "^0.7.0",
    "@tanstack/react-router": "^1.95.0",
    "@tanstack/react-query": "^5.62.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
