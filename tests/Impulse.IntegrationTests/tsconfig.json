{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./wwwroot/js",
    "rootDir": "./Features",
    "declaration": false,
    "sourceMap": true
  },
  "include": ["Features/**/*.tsx", "Features/**/*.ts"],
  "exclude": ["node_modules", "wwwroot"]
}
