@client

<div className="avatar" style="width: 64px; height: 64px; border-radius: 50%; overflow: hidden; background: #e0e0e0;">
  @if (Props.Src)
  {
    <img src="@Props.Src" alt="@Props.Alt" style="width: 100%; height: 100%; object-fit: cover;" />
  }
  else
  {
    <div className="avatar-placeholder" style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 24px; color: #666;">
      @Props.Alt?.Substring(0, 1)
    </div>
  }
</div>

@code {
    [Parameter] public string? Src { get; set; }
    [Parameter] public string? Alt { get; set; }
}
