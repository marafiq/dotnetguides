@inherits SliceComponent<AppProps>

<div class="app-container">
    <header class="app-header">
        <h1>@Props.Title</h1>
        <p>@Props.Description</p>
    </header>

    <main class="app-main">
        @foreach (var user in Props.Users)
        {
            <UserProfile
                Name="@user.Name"
                JobTitle="@user.JobTitle"
                AvatarUrl="@user.AvatarUrl"
                Initials="@user.Initials"
                IsVerified="@user.IsVerified"
                Bio="@user.Bio"
                Stats="@user.Stats"
                Skills="@user.Skills"
                OnFollow="@user.OnFollow"
                OnMessage="@user.OnMessage"
            />
        }
    </main>

    <footer class="app-footer">
        <p>Generated from Razor by Shalimar Compiler</p>
    </footer>
</div>
