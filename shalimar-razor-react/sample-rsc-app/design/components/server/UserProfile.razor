@* Server Component - Runs on .NET, sends HTML *@
@server
@using Shadcn.UI { Avatar, AvatarImage, AvatarFallback, Badge }

<div className="flex items-center gap-4">
    <Avatar className="h-16 w-16">
        <AvatarImage src="@Props.User.AvatarUrl" />
        <AvatarFallback>@Props.User.Initials</AvatarFallback>
    </Avatar>

    <div>
        <h3 className="font-semibold text-lg">@Props.User.Name</h3>
        <p className="text-muted-foreground">@Props.User.Email</p>

        @if (Props.User.IsVerified)
        {
            <Badge variant="secondary">Verified</Badge>
        }
    </div>
</div>

<div className="mt-4 grid grid-cols-3 gap-4 text-center">
    <div>
        <div className="text-2xl font-bold">@Props.User.ProjectCount</div>
        <div className="text-sm text-muted-foreground">Projects</div>
    </div>
    <div>
        <div className="text-2xl font-bold">@Props.User.FollowerCount</div>
        <div className="text-sm text-muted-foreground">Followers</div>
    </div>
    <div>
        <div className="text-2xl font-bold">@Props.User.Rating</div>
        <div className="text-sm text-muted-foreground">Rating</div>
    </div>
</div>
