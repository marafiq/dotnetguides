@* Client Component - Hydrated by React for interactivity *@
@client
@using Shadcn.UI { Button }
@using Lucide { Heart }

<Button
    variant="@(State.IsLiked ? "default" : "outline")"
    @onclick="HandleLike"
    className="gap-2"
>
    <Heart
        className="@(State.IsLiked ? "fill-current" : "")"
        size="16"
    />
    <span>@State.Count</span>
</Button>

@code {
    [Prop] string PostId { get; set; }
    [Prop] int InitialCount { get; set; }

    [State] int Count { get; set; }
    [State] bool IsLiked { get; set; }

    protected override void OnInitialized()
    {
        Count = InitialCount;
        IsLiked = false;
    }

    async Task HandleLike()
    {
        IsLiked = !IsLiked;
        Count += IsLiked ? 1 : -1;

        // Call server action
        await ServerActions.ToggleLike(PostId, IsLiked);
    }
}
