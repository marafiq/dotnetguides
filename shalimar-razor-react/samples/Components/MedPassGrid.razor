@inherits SliceComponent<MedPassGridProps>

<div class="med-pass-grid">
    <div class="grid-header">
        <h1>Medication Pass</h1>
        <span class="timestamp">@Props.PassTime.ToString()</span>
    </div>

    @if (Props.Residents.Any())
    {
        <div class="grid-container">
            @foreach (var resident in Props.Residents)
            {
                <ResidentCard
                    resident="@resident"
                    onSelect="@HandleResidentSelect" />
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <p>No residents scheduled for this pass time.</p>
        </div>
    }

    <div class="grid-footer">
        <span class="count">@Props.Residents.Count residents</span>
        <button class="btn" @onclick="@OnRefresh">Refresh</button>
    </div>
</div>
